{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": "dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/public"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "ai": {
    "binding": "AI"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c0280be3a1b74ed29bcb67b9ac74f1ac"
    }
  ],
  "routes": [
    {
      "pattern": "dev.coralworld.xyz/s/*",
      "zone_name": "coralworld.xyz"
    }
  ],
  // "pages_build_output_dir": "dist/",
  "env": {
    "nonprod": {
      "name": "sink-nonprod",
      "ai": {
        "binding": "AI"
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "sink"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "c0280be3a1b74ed29bcb67b9ac74f1ac"
        }
      ],
      "routes": [
        {
          "pattern": "dev.coralworld.xyz/s/*",
          "zone_name": "coralworld.xyz"
        },
        {
          "pattern": "qa.coralworld.xyz/s/*",
          "zone_name": "coralworld.xyz"
        },
        {
          "pattern": "sit.coralworld.xyz/s/*",
          "zone_name": "coralworld.xyz"
        },
        {
          "pattern": "ilinks.coralworld.xyz",
          "custom_domain": true
        }
      ]
    },
    "prod": {
      "name": "sink-prod",
      "ai": {
        "binding": "AI"
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "sink"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "f5e42098f8ed4461b43ac17fa3b32930"
        }
      ],
      "routes": [
        {
          "pattern": "coralworld.co/s/*",
          "zone_name": "coralworld.co"
        },
        {
          "pattern": "ilinks.coralworld.co",
          "custom_domain": true
        }
      ]
    }
  }
}
